# ---------------------------------------------------------------- 依赖
node_modules/
.pnpm-store/

# ---------------------------------------------------------------- 运行时数据
# 软件运行产生的数据（索引库、封面缓存、撤销副本、备份）。
# 这些不属于源码，发布时必须从零开始，绝不入库。
data/
# 必须锚定到仓库根：裸 `Release/` 会在任意深度匹配，
# 把源码目录 tools/release/（发布脚本）一并忽略掉，
# 导致发布流程从未进入版本历史。
/Release/
# 压缩包按需解码的缓存（P2）：纯派生数据，可随时清空重建
luna_cache/
dist/
*.db
*.db-shm
*.db-wal
.lam-undo/

# ---------------------------------------------------------------- 验证产物
screenshots/
*.tmp.png

# ---------------------------------------------------------------- 日志与系统文件
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 编辑器
.vscode/
.idea/
*.swp
